[Unit]
Description=roadsense signd (traffic-sign detector + tracker)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

# --lights-road-users --lights-ru-scale (roadsense lane L42): the light detector's road users (person, rider, car, truck, bus,
# train, motor, bike) go out in every lights message, decoded from the inference that runs for the lights (no
# extra detector run); the governor's first step pauses them. The optional road-user view (--lights-ru-roi, an
# extra detector run for near road users) is not enabled here.
[Service]
Type=simple
Slice=roadsense.slice
# Phase 1: root. The frame ring lives in /dev/shm and logind would remove a
# normal user's shm segments at logout (RemoveIPC); a system user comes later.
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
# Wait for camerad's frame ring (its unit is 'started' before the ring exists).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/shm/roadsense-frames ] && exit 0; sleep 1; done; exit 0'
# Detector on the GPU (ncnn/Vulkan), classifier on ORT with 2 threads, CPU side on the big cores
# (shared with modeld's model thread and envd since 2026-10-26), capped at 5 frames/s so modeld keeps >= 9 road
# messages/s: ~5 signs/s at ~68 C instead of 5.6 signs/s at 94 C+ on four A75s (ORT 4 threads).
# Uncapped (no --max-hz) gives 8.7 signs/s and 8.7 road/s at ~72 C. Measurements: roadsense
# docs/lanes/L1-signs-vulkan.md (2026-10-24). With the L3 speed profile of the roadsense modeld unit
# (all clocks pinned, modeld on cpus 4-7) 5 Hz gives 5.0 signs/s at detect_ms ~81 next to 13.1 road/s;
# uncapped (measured before the clock pins) 9.1 signs/s but road fell to 9.0/s (roadsense docs/lanes/L3-speed.md, 2026-10-26).
# Needs the ncnn build (scripts/install-phone.sh with
# NCNN_DIR) and the *-ncnn models; `--backend ort --threads 4` is the CPU fallback.
# --gpu-sync turn: the detector asks modeld for the GPU and runs between two model runs instead of
# stalling one halfway (roadsense docs/ARCHITECTURE.md "GPU schedule", docs/lanes/L4-gpu-sched.md, 2026-10-27:
# with modeld's turn-taking road 13.0 -> 14.05 runs/s and road latency p90 168 -> 126 ms at 5.0 signs/s; signs
# latency +15 ms: 118 -> 134 ms median). Without modeld it does not wait.
# --lights: traffic lights in a second thread (<rundir>/lightd.sock, roadsense docs/lanes/L7-traffic-lights.md, 2026-10-27):
# BDD100K YOLO11n 960x320 on the upper 62 % of the frame with ncnn's CPU kernels on the big cores (2 threads), 3 Hz,
# state CNN per light. Cost on the replay: road 14.04 -> 13.72 runs/s, signs unchanged (4.99/s), lights 3.0/s at
# ~140 ms frame->ws. On the GPU (turns with modeld) the same detector cost 4 road runs/s; on the little cores
# (--lights-cpus 0-3 --lights-threads 4) road 13.78/s but lights latency 213 ms. Without the state CNN file
# (research-licensed, installed by hand) the colour rule decides.
# Round red acceptance (roadsense docs/lanes/L8-sign-fp.md, 2026-10-27): stop lamps and red lights read as no-entry
# are flagged `suppressed` by the verifier CNN (docs/SIGN_MODELS.md section 6; research-licensed, installed by hand;
# a missing file just disables it), glow (only while the verifier is unsure) and no-entry's minimum best score 0.71.
# Krakow replay (2 loops): false no-entry tracks 9.5 -> 0 per loop, real round red tracks kept 65/65, no road/signs cost.
# L12 (roadsense docs/lanes/L12-mtsd-retrain.md, 2026-10-27): classifier retrained on MTSD with `other-sign` and
# `background` classes (docs/SIGN_MODELS.md section 7; CC BY-NC-SA data, installed by hand, never committed: without
# the file signd does not start; drop --cls/--cls-names to fall back to the original classifier); tracks voted
# `background` are flagged `not_a_sign`; --dist-match-new 2.0 lets a one-hit track follow a small sign that moves more
# than its width between 5 Hz frames (the krakow B-33 70 and the s1 D-7 were detected but never tracked).
# L15 (roadsense docs/lanes/L15-stability.md, 2026-11-16): lights that were there and not reported. --lights-roi2: every
# other light frame looks at the middle 960x320 pixels around the horizon at scale 1.0 instead of the wide band at 0.72
# (far lights; same number of detector runs, so the same cost); --lights-thr-keep 0.12: weak boxes continue a track and
# never start one; --lights-coast 2: a confirmed track stays in the message for two more light frames after its last
# match (flagged `coast`). krakow-night-tunnel replay at 2.9 Hz: reported share of the light-time 82 -> 94 %, of the
# lights under 12 px 39 -> 81 %, drop-outs 4.8 -> 1.6 per minute of light-time. The roi2 rows assume the horizon near the
# middle of the frame (the car's DVR camera, pitch not calibrated): adjust with the camera's pitch.
# L21 (roadsense docs/lanes/L21-budget-and-models.md, 2026-11-18): lights at 5 Hz instead of 3 (each of the two views
# 2.5 times a second; --lights-coast 3 keeps the 0.6 s a missed light stays listed). On the replays the reported share of
# the light-time went from 95.5 to 98.3 % by day and 93.6 to 98.9 % at night, lights under 12 px 81 -> 93-96 %, drop-outs
# 1.7-2.4 -> 0-0.2 per minute of light-time. It costs 36 % of a big core, paid for by envd's move to the little cores
# (roadsense unit). State model: the first file of the list that is installed; lights_state_car_48x24.onnx is the BDD
# model retrained with clipped-highlight augmentation and fine-tuned on labelled detections from the car's own camera
# (docs/LIGHT_MODELS.md): lit lights of the car's drives given their colour 70 -> 91 % (cross-validated), reported
# dark 29 -> 9 %.
# L53 (roadsense docs/lanes/L53-owner-decisions.md; owner's decision 2026-11-21): --lights-idle ZW.Z.W. While the
# light tracker holds no track at all, one frame period in three gets no detector pass (wide and zoomed views kept);
# the first box that may start a track brings the full schedule back with the next frame. Idle messages carry
# `idle: {pattern, hz}` so the integrator judges the stream against the announced 3.3 a second, not the full
# floor. L48 (roadsense docs/lanes/L48-system-optimisation.md 3.2, L48-phone-results.md P2): 0.24-0.59 W and 4-6 K
# on the big cores less, light-time 96.9 -> 96.8 % / 98.9 -> 99.5 % on the phone's backend. Sparser patterns (one
# pass in 2, 3, 4 periods) lose far-light time measurably (L53 report); `--lights-idle` removed = the old schedule.
# Detection inputs for the tracker (chris-signs lane detin, docs/DETECTION_INPUTS.md; roadsense
# docs/lanes/detin-detection-inputs.md) and the pose head (lane viewhead, docs/POSE_HEAD.md), installed 2026-11-24
# (chris-integrator reads them with in_app, in_width, in_lamp_size, in_scale, in_pose_* on in /etc/chris/radar.json):
# --lights-ru-emb yuv (model-free appearance vector yuv3x3; the learnt reid32 file stays off), --lights-ru-low 0.10
# (low-score list road_users_low), --lights-ru-flags (trunc/occ), --lights-ru-view (sym, lamp pair in the dark),
# --lights-ru-scale-lamps and --lights-ru-scale-multi 3 (scale rate from the lamp pair and 3 baselines),
# --lights-ru-pose pose1-m64.onnx (heading and ground contact per vehicle box, contract pose1, at most 4 runs a pass;
# the weights are private and installed by hand; without the file signd runs without pose). Phone bench 2026-11-24,
# stack off, signd alone on replay (no modeld), warsaw-city at 10 min (busy day): light thread 103.5 -> 102.7 (detin)
# -> 103.5 % of a big core (+ pose), lights 4.75 -> 4.76 fps, lights_ms 123.4 -> 122.8 -> 124.9, signs 4.94/s
# unchanged, poses on 78 of 78 vehicle boxes; krakow-lights, krakow-night-tunnel and a1-night-fog alike within noise.
ExecStart=/usr/local/bin/signd --det-backend ncnn --cls-backend ort --threads 2 --cpus 4-7 --max-hz 5 --gpu-sync turn --stats 10 --lights --lights-backend ncnn-cpu --lights-threads 2 --lights-cpus 4-7 --lights-hz 5 --lights-roi2 0.125,0.125,0.875,0.569 --lights-thr-keep 0.12 --lights-coast 3 --lights-road-users --lights-ru-scale --lights-state /var/lib/roadsense/models/lights_state_car_48x24.onnx,/var/lib/roadsense/models/lights_state_bdd_48x24.onnx --verifier /var/lib/roadsense/models/sign_verifier_32.onnx --class-min-score regulatory--no-entry=0.71 --cls /var/lib/roadsense/models/mtsd_signcls_l12_64.onnx --cls-names /var/lib/roadsense/models/mtsd_signcls_l12_classes.txt --dist-match-new 2.0 --lights-idle ZW.Z.W --lights-ru-emb yuv --lights-ru-low 0.10 --lights-ru-flags --lights-ru-view --lights-ru-scale-lamps --lights-ru-scale-multi 3 --lights-ru-pose /var/lib/roadsense/models/pose1-m64.onnx
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
