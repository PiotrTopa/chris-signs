[Unit]
Description=roadsense signd (traffic-sign detector + tracker)
PartOf=roadsense.target
After=roadsense-camerad.service
Wants=roadsense-camerad.service

[Service]
Type=simple
Slice=roadsense.slice
# Phase 1: root. The frame ring lives in /dev/shm and logind would remove a
# normal user's shm segments at logout (RemoveIPC); a system user comes later.
Environment=ROADSENSE_RUNDIR=/run/roadsense
Environment=ROADSENSE_CONFIG_DIR=/etc/roadsense
RuntimeDirectory=roadsense
RuntimeDirectoryPreserve=yes
StateDirectory=roadsense
# Wait for camerad's frame ring (its unit is 'started' before the ring exists).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/shm/roadsense-frames ] && exit 0; sleep 1; done; exit 0'
# Detector on the GPU (ncnn/Vulkan), classifier on ORT with 2 threads, CPU side on the big cores
# (shared with modeld's model thread and envd since 2026-10-26), capped at 5 frames/s so modeld keeps >= 9 road
# messages/s: ~5 signs/s at ~68 C instead of 5.6 signs/s at 94 C+ on four A75s (ORT 4 threads).
# Uncapped (no --max-hz) gives 8.7 signs/s and 8.7 road/s at ~72 C. Measurements: roadsense
# docs/lanes/L1-signs-vulkan.md (2026-10-24). With the L3 speed profile of the roadsense modeld unit
# (all clocks pinned, modeld on cpus 4-7) 5 Hz gives 5.0 signs/s at detect_ms ~81 next to 13.1 road/s;
# uncapped (measured before the clock pins) 9.1 signs/s but road fell to 9.0/s (roadsense docs/lanes/L3-speed.md, 2026-10-26).
# Needs the ncnn build (scripts/install-phone.sh with
# NCNN_DIR) and the *-ncnn models; `--backend ort --threads 4` is the CPU fallback.
# --gpu-sync turn: the detector asks modeld for the GPU and runs between two model runs instead of
# stalling one halfway (roadsense docs/ARCHITECTURE.md "GPU schedule", docs/lanes/L4-gpu-sched.md, 2026-10-27:
# with modeld's turn-taking road 13.0 -> 14.05 runs/s and road latency p90 168 -> 126 ms at 5.0 signs/s; signs
# latency +15 ms: 118 -> 134 ms median). Without modeld it does not wait.
# --lights: traffic lights in a second thread (<rundir>/lightd.sock, roadsense docs/lanes/L7-traffic-lights.md, 2026-10-27):
# BDD100K YOLO11n 960x320 on the upper 62 % of the frame with ncnn's CPU kernels on the big cores (2 threads), 3 Hz,
# state CNN per light. Cost on the replay: road 14.04 -> 13.72 runs/s, signs unchanged (4.99/s), lights 3.0/s at
# ~140 ms frame->ws. On the GPU (turns with modeld) the same detector cost 4 road runs/s; on the little cores
# (--lights-cpus 0-3 --lights-threads 4) road 13.78/s but lights latency 213 ms. Without the state CNN file
# (research-licensed, installed by hand) the colour rule decides.
# Round red acceptance (roadsense docs/lanes/L8-sign-fp.md, 2026-10-27): stop lamps and red lights read as no-entry
# are flagged `suppressed` by the verifier CNN (docs/SIGN_MODELS.md section 6; research-licensed, installed by hand;
# a missing file just disables it), glow (only while the verifier is unsure) and no-entry's minimum best score 0.71.
# Krakow replay (2 loops): false no-entry tracks 9.5 -> 0 per loop, real round red tracks kept 65/65, no road/signs cost.
# L12 (roadsense docs/lanes/L12-mtsd-retrain.md, 2026-10-27): classifier retrained on MTSD with `other-sign` and
# `background` classes (docs/SIGN_MODELS.md section 7; CC BY-NC-SA data, installed by hand, never committed: without
# the file signd does not start; drop --cls/--cls-names to fall back to the original classifier); tracks voted
# `background` are flagged `not_a_sign`; --dist-match-new 2.0 lets a one-hit track follow a small sign that moves more
# than its width between 5 Hz frames (the krakow B-33 70 and the s1 D-7 were detected but never tracked).
ExecStart=/usr/local/bin/signd --det-backend ncnn --cls-backend ort --threads 2 --cpus 4-7 --max-hz 5 --gpu-sync turn --stats 10 --lights --lights-backend ncnn-cpu --lights-threads 2 --lights-cpus 4-7 --lights-hz 3 --lights-state /var/lib/roadsense/models/lights_state_bdd_48x24.onnx --verifier /var/lib/roadsense/models/sign_verifier_32.onnx --class-min-score regulatory--no-entry=0.71 --cls /var/lib/roadsense/models/mtsd_signcls_l12_64.onnx --cls-names /var/lib/roadsense/models/mtsd_signcls_l12_classes.txt --dist-match-new 2.0
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=roadsense.target
